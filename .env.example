# Copy to .env and adjust. Only LLM_BASE_URL and LLM_MODEL are required for the LLM commands;
# `fetch` and `split` work without any LLM.

# Any OpenAI-compatible chat completions endpoint (include the /v1 suffix).
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional: only needed by hosted APIs. Leave empty for local vLLM / Ollama.
LLM_API_KEY=
# How JSON output is requested: text (schema in the prompt only, works everywhere),
# json_object or json_schema (also send response_format, if the server supports it).
LLM_OUTPUT_MODE=text
# Optional tuning.
LLM_TEMPERATURE=0
LLM_TIMEOUT=120
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=3
# LLM_MAX_TOKENS=2048
# Optional extra JSON fields merged into each request, e.g. to turn off Qwen3 thinking on vLLM:
# LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# ClinicalTrials.gov client.
CTGOV_TIMEOUT=30
# Cache directory for fetched studies ("off" disables the cache). Default: ~/.cache/ctgov-extract
# CTGOV_CACHE_DIR=
# Cache lifetime in seconds (default 7 days).
CTGOV_CACHE_TTL=604800
